# Pre-FROM scope: this ARG is visible to the FROM line only. It is NOT in scope
# inside the build stage — if anything below ever references ${HAILORT_VERSION},
# re-declare it with a bare `ARG HAILORT_VERSION` after the FROM, or it silently
# expands to the empty string.
#
# Deliberately no default value. Omitting --build-arg HAILORT_VERSION resolves
# this to `hailo-base:v` and fails immediately, rather than quietly building on
# a stale base image while the output carries a newer tag.
ARG HAILORT_VERSION
FROM hailo-base:v${HAILORT_VERSION}

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3-venv \
    ffmpeg \
    libglib2.0-0 libsm6 libxext6 libxrender1 \
    python3-opencv \
    nano wget curl jq \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages \
    fastapi uvicorn[standard] python-multipart pillow requests \
    pyclipper shapely sentencepiece

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

COPY ml_target/ ml_target/
COPY models/ models/

EXPOSE 3003

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -sf http://localhost:3003/ping || exit 1

CMD ["python3", "-m", "uvicorn", "ml_target.app:app", "--host", "0.0.0.0", "--port", "3003"]
