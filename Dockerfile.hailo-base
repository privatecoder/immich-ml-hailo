FROM ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive

# Declared after FROM, so these are in stage scope and expand in RUN and COPY
# below. (An ARG placed *before* FROM would only be visible to the FROM line.)
#
# HAILORT_VERSION deliberately has no default: it must match the host's
# hailo_pci kernel module version exactly, and guessing produces an image that
# fails at VDevice() with HAILO_INVALID_DRIVER_VERSION(76). With no default, an
# omitted --build-arg leaves it empty and the COPY below fails on a missing
# filename instead of silently installing whatever version is lying around.
ARG HAILORT_VERSION
ARG DEB_ARCH=amd64
ARG WHL_ARCH=x86_64

RUN apt-get update && apt-get install -y \
    python3-pip python3-dev python3-netifaces \
    build-essential pciutils \
    && rm -rf /var/lib/apt/lists/*

# Name both packages exactly rather than globbing hailort* — hailo-rt-4/ may
# hold several versions side by side, and a glob would copy all of them into the
# layer while happily building whichever one the ARG happens to name. Naming the
# files means a version with no matching packages fails here, at COPY time,
# before anything is installed.
COPY hailo-rt-4/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
     hailo-rt-4/hailort-${HAILORT_VERSION}-cp312-cp312-linux_${WHL_ARCH}.whl \
     /tmp/

RUN dpkg-deb -x /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb / \
    && rm -f /tmp/hailort_${HAILORT_VERSION}_${DEB_ARCH}.deb \
    && ldconfig

RUN pip3 install --break-system-packages --no-deps /tmp/hailort-${HAILORT_VERSION}-cp312-cp312-linux_${WHL_ARCH}.whl \
    && pip3 install --break-system-packages argcomplete contextlib2 future netaddr "numpy<2" \
    && rm -f /tmp/hailort-${HAILORT_VERSION}-cp312-cp312-linux_${WHL_ARCH}.whl

# Remove build tools no longer needed at runtime
RUN apt-get purge -y --auto-remove build-essential python3-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
CMD ["bash"]